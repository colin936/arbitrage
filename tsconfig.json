{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./src",
    "paths": {
      "@components/*": ["app/components/*"],
      "@pages/*": ["app/pages/*"],
      "@services/*": ["app/services/*"],
      "@styles/*": ["app/styles/*"],
      "@api/*": ["server/api/*"],
      "@edge/*": ["server/edge/*"],
      "@jobs/*": ["server/jobs/*"],
      "@lib/*": ["server/lib/*"],
      "@types/*": ["shared/types/*"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}